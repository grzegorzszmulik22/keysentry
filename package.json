{
  "name": "keysentry",
  "version": "0.1.0",
  "description": "Breach-day key rotation and key monitoring: find every copy of every secret across your hosts, rotate in a safe order with one redeploy per service, verify, revoke, and rotate automatically on suspicious use.",
  "type": "module",
  "bin": {
    "keysentry": "dist/keysentry.mjs"
  },
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "bundle": "node scripts/build-bundle.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:check": "node scripts/check-reproducible.mjs",
    "release:sign": "node scripts/sign-release.mjs"
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^12.1.0",
    "fast-xml-parser": "5.11.2",
    "libsodium-wrappers": "^0.8.4",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
