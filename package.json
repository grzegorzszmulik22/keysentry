{
  "name": "keysentry",
  "version": "0.1.0",
  "description": "Breach-day key rotation and key monitoring: find every copy of every secret across your hosts, rotate in a safe order with one redeploy per service, verify, revoke, and rotate automatically on suspicious use.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grzegorzszmulik22/keysentry.git"
  },
  "homepage": "https://github.com/grzegorzszmulik22/keysentry#readme",
  "bugs": {
    "url": "https://github.com/grzegorzszmulik22/keysentry/issues"
  },
  "type": "module",
  "bin": {
    "keysentry": "dist/keysentry.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "bundle": "node scripts/build-bundle.mjs",
    "release:build": "node scripts/release-build.mjs",
    "release:check": "node scripts/check-reproducible.mjs",
    "release:sign": "node scripts/sign-release.mjs",
    "build:ui": "node scripts/build-ui.mjs"
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "commander": "^15.1.0",
    "fast-xml-parser": "5.12.1",
    "libsodium-wrappers": "^0.8.4",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
